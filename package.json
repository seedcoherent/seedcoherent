{
  "name": "seedcoherent",
  "version": "0.35.0",
  "description": "Schema-aware synthetic data generator. Point it at your Postgres, MySQL, SQLite, or SQL Server schema, get coherent, referentially-correct fake data.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "seedcoherent": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "author": "Jacob Jensen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seedcoherent/seedcoherent.git"
  },
  "homepage": "https://github.com/seedcoherent/seedcoherent#readme",
  "bugs": {
    "url": "https://github.com/seedcoherent/seedcoherent/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --import tsx test/*.test.ts",
    "demo": "npm run build && vhs demo/demo.tape",
    "playground:dev": "vite web/playground",
    "playground:build": "vite build web/playground",
    "playground:typecheck": "tsc --noEmit -p web/playground/tsconfig.json",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "postgres",
    "mysql",
    "sqlite",
    "seed",
    "fake-data",
    "synthetic-data",
    "test-data",
    "faker",
    "database",
    "database-testing",
    "data-anonymization",
    "testing",
    "fixtures"
  ],
  "license": "MIT",
  "dependencies": {
    "@faker-js/faker": "^9.3.0",
    "better-sqlite3": "^12.11.1",
    "commander": "^12.1.0",
    "mssql": "^11.0.1",
    "mysql2": "^3.23.2",
    "pg": "^8.13.1",
    "pg-copy-streams": "^7.0.0",
    "pgsql-ast-parser": "^12.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/pg-copy-streams": "^1.2.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
